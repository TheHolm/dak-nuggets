# Build artifacts
build/
build-*/
_build/
dist/
*.o
*.so
*.a

# Packaging (CI-generated staging dirs - see scripts/ and .woodpecker/)
stage-root*/
stage-bundle*/
.pkg-manifest-stage/

# Meson
meson-logs/
meson-private/

# Rust
target/
# Cargo.lock is deliberately NOT ignored. Every Rust program here is a binary,
# not a library, and the Rust convention for binaries is to commit the lockfile:
# it makes package builds reproducible and stops a bad upstream crate release
# entering a build unnoticed. Libraries would be the other way round.

# Go
*.exe
/bin/

# Python
__pycache__/
*.pyc

# Editors / OS
*~
*.swp
.DS_Store
